{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 6am on saturday"],
  "timezone": "America/Sao_Paulo",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      "groupName": "precisa-saude packages",
      "matchPackageNames": ["/^@precisa-saude//"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "pinDigests": true
    },
    {
      "matchPackageNames": [
        "/^@precisa-saude/(agent-instructions|cli|commitlint-config|eslint-config|prettier-config|tsconfig|worktree-cli|themes|ui)$/",
        "Precisa-Saude/tooling"
      ],
      "groupName": "precisa-tooling",
      "groupSlug": "precisa-tooling",
      "separateMajorMinor": false,
      "automerge": false,
      "rangeStrategy": "pin"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=npm depName=(?<depName>@precisa-saude/cli)\\s+CLI_VERSION: [\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ]
}
