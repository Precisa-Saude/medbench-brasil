{
  "enabled": true,
  "provider": "openrouter",
  "fallbackProviders": ["anthropic"],
  "includePaths": ["packages/**", "scripts/**", "probes/**", ".github/**", "docs/**", "README.md"],
  "excludePaths": ["**/fixtures/**", "results/**", "**/*.raw.jsonl", "**/data/**", "**/dist/**"],
  "scanForSecretsBeforeSending": true,
  "onSensitiveContent": "block"
}
